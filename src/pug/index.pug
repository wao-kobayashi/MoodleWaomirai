//- WAO未来塾関連のページ一覧
//- lms-moodle のリンク一覧は scripts/page-index.js が各ページ先頭のメタ情報（//- @title など）から
//- 自動生成し、locals の pageIndex として渡される。リンクを追加・変更するときは各ページの Pug を編集する
doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    title WAO未来塾関連のページ一覧
    meta(name="viewport", content="width=device-width, initial-scale=1,minimum-scale=1.0, maximum-scale=1.0, user-scalable=no")
    meta(name="robots", content="noindex,nofollow")
    meta(name="apple-mobile-web-app-capable", content="yes")
    meta(name="apple-mobile-web-app-status-bar-style", content="black-translucent")
    style.
      /* Moodle Listの基本スタイル */
      .moodle-list {
        font-family: Arial, sans-serif;
        padding-left: 20px;
        list-style: none;
      }

      .moodle-list > li {
        margin-bottom: 10px;
      }

      /* 階層構造のインデント */
      .moodle-list li > ul {
        margin-left: 0px;
        margin-top:10px;
      }

      .moodle-list li > ul li {
        margin-bottom: 5px;
      }

      /* リンクのスタイル */
      .moodle-list a {
        color: #0073e6;
        text-decoration: none;
      }

      .moodle-list a:hover {
        text-decoration: underline;
      }

      /* セクションごとのスタイル */
      .moodle-list li > ul > li {
        font-size: 14px;
        color: #333;
      }

      /* セクションタイトルのスタイル */
      .moodle-list li > ul > li > a {
        padding-left: 10px;
      }

      /* 最後のリストアイテムに余白を追加 */
      .moodle-list li:last-child {
        margin-bottom: 20px;
      }
      h3{
        margin:0 0 4px;
      }
      .moodle-list-category{
        color:#999;
        font-size:12px;
        margin:0 0 4px;
      }
      .moodle-list-group{
        font-size:87%;
        margin:20px 0 0 20px;
      }
      /* @title 未設定のページ */
      .moodle-list a.is-untitled {
        color: #c00;
      }

  body
    //- 各カテゴリは「h3 見出し」+「.moodle-list-category(ID一覧)」+「小見出しごとのリンクUL」の構成
    //- .moodle-list-category には該当カテゴリに対応するページIDをカンマ区切りで記載し、
    //- 開発時の検索・画面識別・E2Eテスト時の参照用メタデータとして使う
    mixin moodleList(environment)
      h2= environment
      ul.moodle-list
        each category in pageIndex
          li
            h3= category.title
            if category.moodleIds
              .moodle-list-category= category.moodleIds
            each group in category.groups
              if group.name
                .moodle-list-group= group.name
              ul
                each link in group.links
                  li
                    a(href=`${environment}/${link.href}`, class=link.untitled ? 'is-untitled' : undefined)= link.label

    div(style="display:flex;width:calc(70% + 40px); margin:0 auto;display: grid;grid-template-columns: repeat(2, 1fr);grid-template-rows: 1fr;grid-column-gap: 30px;")

      div(style="padding:10px 20px 30px; box-shadow:0 5px 10px #ccc;")
        +moodleList('moodle-lms')
      div(style="padding:10px 20px 30px; box-shadow:0 5px 10px #ccc; position:relative;")
        div(style="position:absolute; width:100%; height:100%; font-size:16px; color:#fff; background:rgba(0,0,0,0.7); left:0; top:0; text-align:center;") <p style="margin:45px 0 0;">今は使わなさそう</p>
        +moodleList('moodle-stg')
    div(style="display:flex;width:calc(70% + 40px); margin:0 auto;")
      div(style="padding:10px 20px 30px; margin:45px auto 45px; box-shadow:0 5px 10px #ccc; width:100%;")
        h2 defalut-tenant(テスト)
        ul.moodle-list
          li
            h3 moodleログイン
            ul
              li
                a(href=`moodle-defaluttenant/index.html`) ログイン
